# ============================================================
# ForCli — Environment Variables
# ============================================================
# 1. Copy this file to .env:   cp .env.example .env
# 2. Fill in ALL values below
# 3. NEVER commit .env to git
# ============================================================

# ── Django ────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Database (MySQL — cPanel) ─────────────────────────────────
# Only needed if you enable MySQL in settings_production.py
DB_NAME=cpanelusername_forcli
DB_USER=cpanelusername_forcliuser
DB_PASSWORD=your_strong_db_password_here
DB_HOST=localhost
DB_PORT=3306
